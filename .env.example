# GitHub Actions / Vite Environment Variables
# In GitHub: Repository Settings -> Secrets and variables -> Actions -> Variables (or Secrets)
#
# Set your backend host:
VITE_WS_HOST=api.cards.tmrww.dev
#
# Set your backend port (leave empty or omit if behind a reverse proxy/SSL on port 443):
VITE_WS_PORT=
#
# (Optional) Protocol override (default: auto-detected as wss: on HTTPS):
# VITE_WS_PROTOCOL=wss:
#
# (Optional) Or provide a complete URL directly:
# VITE_WS_URL=wss://api.cards.tmrww.dev

